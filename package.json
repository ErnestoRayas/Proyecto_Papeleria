{
  "name": "react-proyecto-papeleria",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env server/index.cjs",
    "test": "vitest run",
    "test:api": "node --test server/*.test.cjs",
    "admin:create": "node --env-file-if-exists=.env server/manage.cjs admin",
    "password:token": "node --env-file-if-exists=.env server/manage.cjs reset"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.0.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.4"
  }
}
